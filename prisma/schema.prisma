// Lab 3 · Relaciones, mapeo y consultas avanzadas
// Grupo: G03 · Emprendimiento: Librería Sapientia Logos 
// TODO Paso 2: este es el schema de EJEMPLO (cafetería). Conserva User y Role tal cual y
// reemplaza Customer/Product/Order/OrderItem por TUS entidades con al menos:
//   · una relación 1:1, una 1:N y una N:M (implícita o explícita)
//   · onDelete elegido a propósito (Cascade, Restrict o SetNull) en cada relación
//   · un enum, un Decimal o DateTime y un @@index o @@unique compuesto
// Tras cualquier cambio: npx prisma migrate dev --name <cambio>
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  DELIVERED
  CANCELLED
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(120)
  password  String // hash de bcrypt, nunca la clave en texto plano
  name      String    @db.VarChar(100)
  role      Role      @default(USER)
  createdAt DateTime  @default(now()) @map("created_at")
  customer  Customer? // 1:1 → el lado sin FK

  @@map("users")
}

// Entidad del Lab 2, ahora relacionada
model Customer {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name") @db.VarChar(100)
  email     String   @unique @db.VarChar(120)
  phone     String?  @db.VarChar(15)
  createdAt DateTime @default(now()) @map("created_at")

  userId Int?  @unique @map("user_id")
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  @@map("customers")
}

model Product {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(80)
  price     Decimal     @db.Decimal(10, 2)
  stock     Int         @default(0)
  category  String?     @db.VarChar(40)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  items     OrderItem[]

  @@map("products")
}

// 1:N: un cliente tiene muchos pedidos; un pedido pertenece a un cliente
model Order {
  id         Int         @id @default(autoincrement())
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(10, 2)
  createdAt  DateTime    @default(now()) @map("created_at")
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@index([customerId])
  @@index([status, createdAt])
  @@map("orders")
}

// N:M explícita: la tabla intermedia guarda datos propios (cantidad y precio)
model OrderItem {
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([orderId, productId])
  @@map("order_items")
}
