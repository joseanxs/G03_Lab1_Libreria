        {
          "name": "B13. Búsqueda con texto y orden por precio (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/search?q=a&sort=price_asc&page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "search"],
              "query": [
                { "key": "q", "value": "a" },
                { "key": "sort", "value": "price_asc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            },
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Respuesta paginada\", () => pm.expect(r).to.include.keys(\"page\", \"limit\", \"total\", \"pages\", \"data\"));",
                  "pm.test(\"Máximo 5 resultados\", () => pm.expect(r.data.length).to.be.at.most(5));",
                  "pm.test(\"Orden ascendente por precio\", () => { const p = r.data.map((b) => Number(b.price)); pm.expect(p).to.eql([...p].sort((a, b) => a - b)); });"
                ]
              }
            }
          ]
        },
