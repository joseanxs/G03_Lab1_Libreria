// Lab 3 · Relaciones, mapeo y consultas avanzadas
// Grupo: G03 · Emprendimiento: Librería Sapientia Logos
// Relaciones: 1:1 User-Customer · 1:N Category-Book y Customer-Order · N:M Order-Book (tabla OrderItem)
// Tras cualquier cambio: npx prisma migrate dev --name <cambio> y luego npx prisma generate

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: la URL ya no va aquí; está en prisma.config.ts
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  DELIVERED
  CANCELLED
}

// Usuario que se autentica con JWT
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(120)
  password  String // hash de bcrypt, nunca la clave en texto plano
  name      String    @db.VarChar(100)
  role      Role      @default(USER)
  createdAt DateTime  @default(now()) @map("created_at")
  customer  Customer? // 1:1 → el lado sin FK

  @@map("users")
}

// Perfil de cliente: se crea junto con el usuario al registrarse
model Customer {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name") @db.VarChar(100)
  email     String   @unique @db.VarChar(120)
  phone     String?  @db.VarChar(15)
  createdAt DateTime @default(now()) @map("created_at")

  // 1:1 con User: la FK es única. Si se borra el usuario, se borra su perfil (Cascade)
  userId Int?  @unique @map("user_id")
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[] // 1:N

  @@map("customers")
}

// Entidad del Lab 2: ahora pertenece a una categoría
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(255)
  aisle       String   @db.VarChar(40)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  books       Book[] // N:M implicita

  @@map("categorias")
}

// Entidad principal del emprendimiento (Lab 1 y Lab 2). Su stock es el recurso limitado de los pedidos
model Book {
  id        Int      @id @default(autoincrement())
  title     String   @unique @map("titulo") @db.VarChar(80)
  author    String   @db.VarChar(80)
  price     Decimal  @db.Decimal(10, 2) // Prisma lo devuelve como texto: "10.50"
  available Boolean  @default(true)
  stock     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  items OrderItem[] // N:M con Order a través de OrderItem
  categories Category[] // N:M implícita: Prisma crea la tabla _BookToCategory
  @@map("libros")
}

// 1:N: un cliente tiene muchos pedidos; un pedido pertenece a un cliente
// Restrict: no se puede borrar un cliente que tiene pedidos (se conserva el historial)
model Order {
  id         Int         @id @default(autoincrement())
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(10, 2)
  createdAt  DateTime    @default(now()) @map("created_at")
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@index([customerId])
  @@index([status, createdAt]) // acelera el filtro del listado de administración
  @@map("orders")
}

// N:M explícita: la tabla intermedia guarda datos propios (cantidad y precio unitario)
// Cascade con el pedido (sin pedido no hay ítems) y Restrict con el libro (no se borra un libro vendido)
model OrderItem {
  orderId   Int     @map("order_id")
  bookId    Int     @map("book_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book      Book    @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@id([orderId, bookId]) // clave primaria compuesta: un libro aparece una sola vez por pedido
  @@map("order_items")
}
