              "raw": "{\n  \"name\": \"Usuario Test\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "auth": { "type": "noauth" }
