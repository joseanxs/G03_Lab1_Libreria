              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Hay al menos un libro\", () => pm.expect(list.length).to.be.above(0));",
                  "if (!pm.collectionVariables.get(\"bookId\")) pm.collectionVariables.set(\"bookId\", list[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "B1. Crear categoría (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Novela {{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.test(\"Devuelve id y name\", () => { pm.expect(c).to.have.property(\"id\"); pm.expect(c.name).to.include(\"Novela\"); });",
                  "pm.collectionVariables.set(\"categoryId\", c.id);",
                  "pm.collectionVariables.set(\"catName\", c.name);"
                ]
              }
            }
          ]
        },
