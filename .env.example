# Copia este archivo como .env (nunca subas .env a GitHub)
PORT=3000
NODE_ENV=development

# PostgreSQL local o con docker compose (mismos datos que docker-compose.yml):
DATABASE_URL="postgresql://espe_user:espe_password@localhost:5432/espe_db?schema=public"
# Neon o Railway (nube): copia la cadena de conexión del panel; en Neon termina en ?sslmode=require
# DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx.neon.tech/NOMBRE_BD?sslmode=require"
